    <script src="/public/assets/js/flowbite.min.js"></script>
    <script src="/public/assets/js/theme-changer.js "></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="/public/assets/js/app.js"></script>
    <script>
        // Flag to track whether the alert has been triggered for each reminder
        const reminderAlertTriggered = {};

        // Function to format date
        function formatDate(dateString) {
            const date = new Date(dateString);
            const options = {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit',
                hour: '2-digit',
                minute: '2-digit'
            };
            return date.toLocaleDateString('en-US', options);
        }
        // Function to compare two dates without considering seconds
        function datesAreEqualWithoutSeconds(date1, date2) {
            return (
                date1.getFullYear() === date2.getFullYear() &&
                date1.getMonth() === date2.getMonth() &&
                date1.getDate() === date2.getDate() &&
                date1.getHours() === date2.getHours() &&
                date1.getMinutes() === date2.getMinutes()
            );
        }


        // Function to fetch Reminders data and update the table
        function fetchDataAndUpdateTable() {
            $.ajax({
                url: "/reminders",
                type: "GET",
                success: function (data) {
                    const tableBody = $("#remindersTable");
                    tableBody.empty(); // Clear existing table rows
                    data.forEach((reminder) => {
                        // Format the deadline
                        const formattedDeadline = formatDate(reminder.deadline);
                        // Check if current time matches the reminder time (ignoring seconds)
                        const currentTime = new Date();
                        const reminderTime = new Date(reminder.deadline);
                        const reminderId = reminder._id;
                        if (datesAreEqualWithoutSeconds(currentTime, reminderTime)) {
                            // Check if the alert for this reminder has already been triggered
                            if (!reminderAlertTriggered[reminderId]) {
                                // Display a toast
                                console.log("Reminder alert triggered for:", reminder.remindertitle);
                                alert(`Reminder: ${reminder.remindertitle}\nDescription: ${reminder.reminderdescription}\nType: ${reminder.remindertype}\nPriority: ${reminder.reminderpriority}\nDeadline: ${formattedDeadline}`);
                                // Set the flag to true to indicate that the alert has been triggered
                                reminderAlertTriggered[reminderId] = true;
                            }
                        } else {
                            // Reset the flag if the current time no longer matches the reminder time
                            reminderAlertTriggered[reminderId] = false;
                        }
                        console.log(formattedDeadline);
                        const row = `
                    <tr>
                        <td>${reminder.remindertitle}</td>
                        <td>${reminder.reminderdescription}</td>
                        <td>${reminder.remindertype}</td>
                        <td>${reminder.reminderpriority}</td>
                        <td>${formattedDeadline}</td>
                        <td><button onclick="deleteReminder('${reminder._id}')" type="button"><svg class="w-5 h-5 text-gray-800 dark:text-white" aria-hidden="true " xmlns="http://www.w3.org/2000/svg " fill="none " viewBox="0 0 20 20 ">
                            <path stroke="currentColor " stroke-linecap="round " stroke-linejoin="round " stroke-width="2 " d="m13 7-6 6m0-6 6 6m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z " />
                        </svg></button></td>
                    </tr>
                `;
                        tableBody.append(row);
                    });
                },
                error: function (error) {
                    console.error("Error:", error);
                    console.log("Error:", error);
                },
            });
        }
        // Function to fetch Journal entries data and update the table
        function fetchJournalDataAndUpdateTable() {
            $.ajax({
                url: "/journals",
                type: "GET",
                success: function (data) {
                    const tableBody = $("#journalEntriesTable");
                    tableBody.empty(); // Clear existing table rows
                    data.forEach((entry) => {
                        const row = `
                            <tr>
                                <td>${entry.journaltitle}</td>
                                <td>${entry.journaldescription}</td>
                                <td><button onclick="deleteJournalEntry('${entry._id}')" type="button">Delete</button></td>
                                <td><button data-modal-target="view-journal-modal" data-modal-toggle="view-journal-modal" type="button">View</button></td>

                            </tr>
                        `;
                        tableBody.append(row);
                    });
                },
                error: function (error) {
                    console.error("Error:", error);
                },
            });
        }
        // Function to create a new reminders entry
        $(document).ready(function () {
            $('#new-reminder-modal form').submit(function (event) {
                // Prevent the default form submission
                event.preventDefault();

                // Serialize form data
                var formData = $(this).serialize();

                // Send AJAX request
                $.post('/new', formData, function (response) {
                    // Handle response from the server
                    console.log(response);

                    // Close the modal after successful submission
                    $('[data-modal-hide="new-reminder-modal"]').click();
                });
            });
        });
        $(document).ready(function () {
            $('#new-journal-modal form').submit(function (event) {
                // Prevent the default form submission
                event.preventDefault();

                // Serialize form data
                var formData = $(this).serialize();

                // Send AJAX request
                $.post('/newjournal', formData, function (response) {
                    // Handle response from the server
                    console.log(response);

                    // Close the modal after successful submission
                    $('[data-modal-hide="new-journal-modal"]').click();
                });
            });
        });
        // Function to delete a person
        function deleteReminder(reminderId) {
            console.log("Deleting reminder with ID:", reminderId);
            $.ajax({
                url: `/reminders/${reminderId}`,
                type: "DELETE",
                success: function (data) {
                    // Call fetchDataAndUpdateTable after successful deletion
                    fetchDataAndUpdateTable();
                },
                error: function (error) {
                    console.error("Error:", error);
                },
            });
        }
        // Function to delete a journal entry
        function deleteJournalEntry(entryId) {
            console.log("Deleting journal entry with ID:", entryId);
            $.ajax({
                url: `/journals/${entryId}`,
                type: "DELETE",
                success: function (data) {
                    // Call fetchJournalDataAndUpdateTable after successful deletion
                    fetchJournalDataAndUpdateTable();
                },
                error: function (error) {
                    console.error("Error:", error);
                },
            });
        }


        // Periodically fetch data and update the table
        $(document).ready(function () {
            fetchDataAndUpdateTable(); // Initial call to populate the table
            setInterval(fetchDataAndUpdateTable, 5000); // Fetch data every 5 seconds (adjust as needed)
        });

        // Periodically fetch data and update the journal entries table
        $(document).ready(function () {
            fetchJournalDataAndUpdateTable(); // Initial call to populate the table
            setInterval(fetchJournalDataAndUpdateTable, 5000); // Fetch data every 5 seconds (adjust as needed)
        });

        const chatForm = document.querySelector("#chat_form");
        async function sendData() {
            // Associate the FormData object with the form element
            const formData = new FormData(chatForm);
            let chatObj = {};
            formData.forEach((value, key) => (chatObj[key] = value));

            const chatArea = document.getElementById('chat_area')
            chatArea.innerHTML += createMessage('You', chatObj.prompt);
            chatForm.reset();

            try {
                fetch("/generate-advice", {
                    method: "POST",
                    headers: {
                        Accept: "application/json",
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(chatObj),
                })
                    .then((response) => {
                        return response.json();
                    })
                    .then((response) => {
                        if (response.success == true) {
                            chatArea.innerHTML += createMessage('Mental Wellbeing Companion', response.data);
                        }
                    });
            } catch (e) {
                console.error(e);
            }
        }

        // Take over form submission
        chatForm.addEventListener("submit", (event) => {
            event.preventDefault();
            sendData();
        });

        function createMessage(user, msg) {
            return `
            <div class="gap-2.5">
                <div class="p-4 flex flex-col gap-1 w-full">
                    <div class="flex items-center space-x-2 rtl:space-x-reverse">
                        <span class="text-sm font-semibold text-gray-900 dark:text-white">${user}</span>
                    </div>
                    <div
                        class="flex justify-between items-center leading-1.5 p-4 border-gray-200 bg-gray-100 w-full rounded-e-xl rounded-es-xl dark:bg-gray-700">
                        <p class="text-sm font-normal text-gray-900 dark:text-white">${msg}</p>
                        <button
                            class="items-center p-1 text-sm font-medium text-center text-gray-900 bg-white rounded-lg hover:bg-gray-100 dark:text-white dark:bg-gray-900 dark:hover:bg-gray-800"
                            type="button"><svg class="w-4 h-4 text-gray-800 dark:text-white" aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                viewBox="0 0 24 24">
                                <path stroke="currentColor" stroke-linejoin="round" stroke-width="2"
                                    d="M9 8v3a1 1 0 0 1-1 1H5m11 4h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-7a1 1 0 0 0-1 1v1m4 3v10a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-7.13a1 1 0 0 1 .24-.65L7.7 8.35A1 1 0 0 1 8.46 8H13a1 1 0 0 1 1 1Z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
            `
        }
    </script>
</body>

